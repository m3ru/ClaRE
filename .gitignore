# Numpy/model artifacts
*.npz
# ...except small refusal vectors we want tracked
!research/refusal_vector/qwen3_extraction/refusal_vector_qwen3*.npz
# ...and the Llama Guard relabelled vectors (tracked before the *.npz rule existed;
# without this they vanish from a clean re-add, e.g. the anonymized export).
!research/refusal_vector/llamaguard_relabel/*.npz
# ...and the small Qwen/Llama signal scorers (vector/probe directions + weights)
!research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/qwen_signals/*.npz
!research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/llama_signals/*.npz

# Activation dumps (large, regeneratable from extract_*_acts.py)
*.npy

# LoRA checkpoint dirs ending in _ckpt (adapter weights + bundled tokenizer copies)
*_ckpt/
*_ckpt_*/
**/rwr_qwen_smoke/

# Local-only archive of old experiments (too large for git)
archive/

# Secrets / API keys — never commit
.env
.env.*
!.env.example
**/openai_key*
**/*.secret
**/secrets/

# Paraphrase API outputs (large, regeneratable)
research/overrefusal_finetuning/paraphrases_api/
**/batch_requests_*.jsonl
**/batch_results_*.jsonl

# Sharded scoring intermediates: merged into probe_or/results/corpus2/<att>_<tgt>.json
research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/corpus2/shards/
# Resumable batch-id sidecars (API job handles, not data)
**/*.batch_id

# --- high/low edit-distance analysis (added this session) ---
# Fitted direction vectors are SMALL and back the causal claims; the 2GB acts.npy they came
# from are not committed, so these npz are the only reproducible record — keep them.
!research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/delta/*.npz
!research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/delta_qwen/*.npz
# Raw generation shards: large intermediates, regeneratable from the run_gen_low_*.slurm seed.
research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/gen_low_llama_logit/
research/overrefusal_finetuning/rwr_overrefusal/probe_or/results/gen_low_qwen_probe/
